# GEMINI_API_KEY: Optional free-tier Gemini API key for AI semantic classification.
# If omitted or if free quota is temporarily reached, NexaMAIL automatically falls back to zero-cost local sorting.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where NexaMAIL is hosted (e.g., https://nexamail-campus.onrender.com).
APP_URL="MY_APP_URL"

# Campus-only college email domains (covers all RVCE students and faculty)
CAMPUS_ALLOWED_DOMAINS="rvce.edu.in"

# Optional: Override Firebase Web App config when deploying under an @rvce.edu.in Google Workspace Internal project
# (Allows unlimited RVCE students & faculty to sign in for free without Google verification fees or the 100-user cap)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
